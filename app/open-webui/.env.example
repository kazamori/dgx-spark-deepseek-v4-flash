# Open WebUI の設定例。cp .env.example .env して値を埋め、chmod 600 .env にする。
# 注意: WEBUI_AUTH、WEBUI_SECRET_KEY、ENABLE_ADMIN_CHAT_ACCESS、BYPASS_MODEL_ACCESS_CONTROL、OPEN_WEBUI_* 以外の設定は、初回起動時に
#       データベースへ保存され、以後はデータベースの値が優先される（PersistentConfig）。
#       初回起動後に変えるときは、管理画面で変更する。
# 注意: 値の後ろにコメントを書かない（値の一部として読まれることがある）。

# --- 公開範囲（compose のポート設定で使う） ---
# 127.0.0.1: chat ホストの中からだけ（ngrok は chat ホストの中から転送するので、これで足りる）
# 0.0.0.0:   社内 LAN のほかのマシンからも接続できる
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=3000

# --- 接続先（spark1 の vLLM） ---
OPENAI_API_BASE_URL=http://192.168.160.37:8888/v1
# vLLM に API キー（DSPARK_API_KEYS）を設定した場合だけ入れる
OPENAI_API_KEY=
ENABLE_OLLAMA_API=false

# --- 認証とアカウント ---
WEBUI_AUTH=true
# 自由な登録を禁止し、管理者がアカウントを作る
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
# セッションの署名鍵。openssl rand -hex 32 などで生成して設定する。空のままにしない
WEBUI_SECRET_KEY=
# 管理者も利用者の会話を閲覧できないようにする
ENABLE_ADMIN_CHAT_ACCESS=false
# 接続先のモデルは既定で管理者にしか見えないので、すべての利用者に公開する（モデルは 1 つだけのため）
BYPASS_MODEL_ACCESS_CONTROL=true
# 新しい会話で最初から選ばれているモデル
DEFAULT_MODELS=deepseek-v4-flash-vision-exp

# --- LLM をバックグラウンドで呼ぶ機能 ---
# spark1 の同時実行数（max-num-seqs 6）を会話に使うため、タイトル生成以外は無効にする
ENABLE_TITLE_GENERATION=true
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
ENABLE_SEARCH_QUERY_GENERATION=false
ENABLE_RETRIEVAL_QUERY_GENERATION=false

# --- 使わない機能 ---
ENABLE_COMMUNITY_SHARING=false
ENABLE_EVALUATION_ARENA_MODELS=false
