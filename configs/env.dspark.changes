# レシピの .env.dspark.example から変更した値だけを抜き出したもの。
# cp .env.dspark.example .env.dspark のあと、該当する行をこの値に書き換える。
# 変数名と書式はレシピ（MIT License, Copyright (c) 2026 Tony Deangelo）に従う。

# ノードの IP（CX-7 側）
WORKER_HOST=192.168.100.11
MASTER_ADDR=192.168.100.10
VLLM_HOST_IP=192.168.100.10
WORKER_VLLM_HOST_IP=192.168.100.11

# NCCL が使う RDMA デバイスと IF
# 先頭の "=" は完全一致指定を表す NCCL の書式（"==" は誤記ではない）。
# example にある NCCL_IB_HCA=rocepXsYfZ の行は削除し、この 1 行だけを残す。
NCCL_IB_HCA==rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0

# API の待受アドレス
# 別のマシンから API を使うため 0.0.0.0 にしている。認証なしで LAN に公開される点に注意する。
# spark1 の中からだけ使う場合は 127.0.0.1 にする。
VLLM_HOST=0.0.0.0

# Hugging Face のアクセストークン（読み取り専用）。値は各自で設定する。
# このファイル（.env.dspark）は chmod 600 にする。
HF_TOKEN=
